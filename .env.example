# Copie para .env e mantenha este arquivo privado.
PORT=3000
HOST=127.0.0.1
# Sem URL do Turso, usa SQLite local. Para Turso, preencha abaixo:
# TURSO_DATABASE_URL=libsql://endereco-do-banco.turso.io
# TURSO_AUTH_TOKEN=cole-somente-no-servidor
# SETUP_TOKEN=gere-um-valor-aleatorio-de-32-a-128-caracteres
# Na Render, configure as variaveis pelo painel Environment.
# RENDER_EXTERNAL_URL e detectada automaticamente pela Render.
# PUBLIC_URL=https://seu-dominio.com.br
# NODE_ENV=production
# HOST=0.0.0.0
# RESEND_API_KEY=configure-no-servidor
# EMAIL_FROM=Sua Barbearia <agenda@seu-dominio.com.br>
