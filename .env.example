# Copie este arquivo para .env. Nunca publique .env ou a pasta data.
# Modo local (padrao):
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/agenda.sqlite

# Para publicar, defina NODE_ENV=production e um endereco HTTPS real.
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_URL=https://agenda.sua-barbearia.com.br
# Ative somente se o servidor estiver atras de proxy confiavel, sem acesso direto.
# TRUST_PROXY=1

# E-mails: conta Resend + dominio de envio verificado.
# Nao preencha com chaves de exemplo; o painel informa quando estiver configurado.
# RESEND_API_KEY=
# EMAIL_FROM=Sua Barbearia <agenda@seu-dominio.com.br>
